# ============================================================
# Backend environment template. Copy to .env and fill in.
#   cp backend-python/.env.example backend-python/.env
# .env is git-ignored and must NEVER be committed.
# ============================================================

# ---- LLM providers ----------------------------------------
# Server-side only. Never expose an LLM key to the browser
# (a VITE_-prefixed var is bundled into the shipped JS).
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Email (SMTP) -----------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=          # Gmail app password, not the account password
EMAIL_FROM_NAME=Hospital Management System
EMAIL_FROM_ADDRESS=

# ---- PostgreSQL -------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_HOST=
DB_PORT=5432
DB_NAME=hospital_management
DB_USER=
DB_PASSWORD=

# ---- Local development alternative ------------------------
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_management
